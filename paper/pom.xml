<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.ganamaga</groupId>
    <artifactId>katharsis_paper</artifactId>
    <version>0.1</version>
    <packaging>jar</packaging>

    <name>katharsis_paper</name>
    <description>Backend companion for the Katharsis Velocity proxy plugin.</description>

    <properties>
        <!--
          Two build variants, one per Paper line, because the lines need
          different JDKs: every 1.21.x API is a Java 21 artifact and every 26.x
          API is a Java 25 one.

            (default)      1.21.x  - paper-api 1.21.1, Java 21
            -P paper-26    26.x    - paper-api 26.1.2, Java 25

          Each is built against the OLDEST API in its line, so it runs on every
          release of that line: a plugin compiled against an old API works on
          newer servers, never the reverse. compat-check.sh proves the API
          surface used here exists across both lines.
        -->
        <paper.variant>1.21.x</paper.variant>
        <paper.version>1.21.1-R0.1-SNAPSHOT</paper.version>
        <paper.api.version>1.21</paper.api.version>
        <paper.supported.min>1.21.1</paper.supported.min>
        <paper.supported.max>1.21.11</paper.supported.max>
        <java.release>21</java.release>
        <required.jdk.range>[21,)</required.jdk.range>
        <!-- Appended to the jar name so the two variants can sit side by side. -->
        <paper.variant.suffix></paper.variant.suffix>

        <junit.version>5.14.4</junit.version>
        <surefire.version>3.6.0</surefire.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <profiles>
        <profile>
            <id>paper-26</id>
            <properties>
                <paper.variant>26.x</paper.variant>
                <paper.version>26.1.2.build.74-stable</paper.version>
                <!-- The 26.x line declares full version strings, unlike the
                     classic major.minor form the 1.21 line uses. -->
                <paper.api.version>26.1.2</paper.api.version>
                <paper.supported.min>26.1.2</paper.supported.min>
                <paper.supported.max>26.3</paper.supported.max>
                <java.release>25</java.release>
                <required.jdk.range>[25,)</required.jdk.range>
                <paper.variant.suffix>-mc26</paper.variant.suffix>
            </properties>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <finalName>${project.artifactId}-${project.version}${paper.variant.suffix}</finalName>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>require-jdk-for-paper-api</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Literal, not ${java.release}: Maven also exposes the
                                     running JVM's own java.* system properties, and a pom
                                     property that collides with one is a coin flip. -->
                                <requireJavaVersion>
                                    <version>${required.jdk.range}</version>
                                    <message>The ${paper.variant} variant is built against paper-api ${paper.version}, whose class files need JDK ${java.release} or newer to read. Build it with that JDK, or drop -P paper-26 to build the 1.21.x variant instead.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- So PluginDescriptorTest can check that the version
                         properties stay consistent with each other. -->
                    <systemPropertyVariables>
                        <katharsis.paper.variant>${paper.variant}</katharsis.paper.variant>
                        <katharsis.paper.version>${paper.version}</katharsis.paper.version>
                        <katharsis.paper.api.version>${paper.api.version}</katharsis.paper.api.version>
                        <katharsis.paper.supported.min>${paper.supported.min}</katharsis.paper.supported.min>
                        <katharsis.paper.supported.max>${paper.supported.max}</katharsis.paper.supported.max>
                        <katharsis.java.release>${java.release}</katharsis.java.release>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
