<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.ganamaga</groupId>
    <artifactId>katharsis_proxy</artifactId>
    <version>0.1</version>
    <packaging>jar</packaging>

    <name>katharsis_proxy</name>

    <properties>
        <java.release>21</java.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <velocity.version>3.5.0-SNAPSHOT</velocity.version>
        <configurate.version>4.2.0</configurate.version>
        <hikaricp.version>7.0.2</hikaricp.version>
        <postgresql.version>42.7.11</postgresql.version>
        <h2.version>2.5.250</h2.version>
        <discord4j.version>3.3.3</discord4j.version>
        <junit.version>5.14.4</junit.version>
        <slf4j.version>2.0.17</slf4j.version>
        <surefire.version>3.6.0</surefire.version>
        <jacoco.version>0.8.15</jacoco.version>
        <!-- Velocity release the integration test boots the built plugin on. -->
        <velocity.test.version>3.5.1</velocity.test.version>
        <!-- Where the downloaded Velocity jar is kept. Point this outside the
             build directory in CI so it survives `clean` and can be cached. -->
        <velocity.cache.dir>${project.build.directory}/velocity</velocity.cache.dir>
        <!-- Shaded dependencies are relocated under this package. -->
        <shade.relocation.base>me.ganamaga.katharsis_proxy.libs</shade.relocation.base>
        <!-- The same package as a path; keep the two in sync. -->
        <shade.relocation.path>me/ganamaga/katharsis_proxy/libs</shade.relocation.path>
    </properties>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <filtering>true</filtering>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>
            <!-- *IT tests run after package, so they see the shaded jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <katharsis.plugin.jar>${project.build.directory}/${project.build.finalName}.jar</katharsis.plugin.jar>
                        <katharsis.velocity.version>${velocity.test.version}</katharsis.velocity.version>
                        <katharsis.velocity.cache>${velocity.cache.dir}</katharsis.velocity.cache>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.zaxxer:HikariCP</include>
                                    <include>org.postgresql:postgresql</include>
                                    <include>com.h2database:h2</include>
                                    <!-- Discord4J and everything it needs at runtime. -->
                                    <include>com.discord4j:*</include>
                                    <include>io.projectreactor:reactor-core</include>
                                    <include>io.projectreactor.addons:reactor-extra</include>
                                    <include>io.projectreactor.netty:*</include>
                                    <include>org.reactivestreams:reactive-streams</include>
                                    <include>io.netty:*</include>
                                    <include>com.fasterxml.jackson.core:*</include>
                                    <include>com.fasterxml.jackson.datatype:*</include>
                                    <include>com.google.crypto.tink:tink</include>
                                    <include>com.google.protobuf:protobuf-java</include>
                                    <include>moe.kyokobot.libdave:*</include>
                                    <include>dev.arbjerg:lava-common</include>
                                    <include>commons-io:commons-io</include>
                                </includes>
                            </artifactSet>
                            <!-- Velocity plugins can see each other's classes, so the JDBC
                                 driver and the pool are relocated to avoid clashing with
                                 another plugin shipping different versions. -->
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>${shade.relocation.base}.hikari</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.postgresql</pattern>
                                    <shadedPattern>${shade.relocation.base}.postgresql</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.h2</pattern>
                                    <shadedPattern>${shade.relocation.base}.h2</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>discord4j</pattern>
                                    <shadedPattern>${shade.relocation.base}.discord4j</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.discord4j.fsm</pattern>
                                    <shadedPattern>${shade.relocation.base}.discord4j.fsm</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>reactor</pattern>
                                    <shadedPattern>${shade.relocation.base}.reactor</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.reactivestreams</pattern>
                                    <shadedPattern>${shade.relocation.base}.reactivestreams</shadedPattern>
                                </relocation>
                                <!-- The proxy bundles its own, unrelocated Netty and plugin class
                                     loaders ask the proxy first, so Netty must be relocated or
                                     Reactor Netty would end up on a mix of both copies. -->
                                <relocation>
                                    <pattern>io.netty</pattern>
                                    <shadedPattern>${shade.relocation.base}.netty</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>${shade.relocation.base}.jackson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.crypto.tink</pattern>
                                    <shadedPattern>${shade.relocation.base}.tink</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.protobuf</pattern>
                                    <shadedPattern>${shade.relocation.base}.protobuf</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.sedmelluq.lava</pattern>
                                    <shadedPattern>${shade.relocation.base}.lava</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.commons.io</pattern>
                                    <shadedPattern>${shade.relocation.base}.commons.io</shadedPattern>
                                </relocation>
                                <!-- The shade plugin does not relocate the Java-version-specific
                                     copies under META-INF/versions/<n>/, so those are moved by
                                     path here, matching the relocations above. -->
                                <relocation>
                                    <pattern>^META-INF/versions/(\d+)/com/zaxxer/hikari/</pattern>
                                    <shadedPattern>META-INF/versions/$1/${shade.relocation.path}/hikari/</shadedPattern>
                                    <rawString>true</rawString>
                                </relocation>
                                <relocation>
                                    <pattern>^META-INF/versions/(\d+)/org/postgresql/</pattern>
                                    <shadedPattern>META-INF/versions/$1/${shade.relocation.path}/postgresql/</shadedPattern>
                                    <rawString>true</rawString>
                                </relocation>
                                <relocation>
                                    <pattern>^META-INF/versions/(\d+)/org/h2/</pattern>
                                    <shadedPattern>META-INF/versions/$1/${shade.relocation.path}/h2/</shadedPattern>
                                    <rawString>true</rawString>
                                </relocation>
                                <relocation>
                                    <pattern>^META-INF/versions/(\d+)/reactor/</pattern>
                                    <shadedPattern>META-INF/versions/$1/${shade.relocation.path}/reactor/</shadedPattern>
                                    <rawString>true</rawString>
                                </relocation>
                                <relocation>
                                    <pattern>^META-INF/versions/(\d+)/io/netty/</pattern>
                                    <shadedPattern>META-INF/versions/$1/${shade.relocation.path}/netty/</shadedPattern>
                                    <rawString>true</rawString>
                                </relocation>
                                <relocation>
                                    <pattern>^META-INF/versions/(\d+)/com/fasterxml/jackson/</pattern>
                                    <shadedPattern>META-INF/versions/$1/${shade.relocation.path}/jackson/</shadedPattern>
                                    <rawString>true</rawString>
                                </relocation>
                                <!-- moe.kyokobot.libdave stays put: its JNI library binds to
                                     those class names. -->
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/INDEX.LIST</exclude>
                                        <exclude>META-INF/versions/*/OSGI-INF/**</exclude>
                                        <exclude>META-INF/io.netty.versions.properties</exclude>
                                        <!-- Micrometer is not shipped, and the entries name relocated classes. -->
                                        <exclude>META-INF/services/io.micrometer.context.ContextAccessor</exclude>
                                        <!-- GraalVM metadata naming the unrelocated classes. -->
                                        <exclude>META-INF/native-image/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- Merges and relocates META-INF/services/java.sql.Driver. -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Reactor, Jackson and Netty ship Java 21 variants under
                                     META-INF/versions, which are only used in a multi-release jar. -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>3.12.1</version>
                <dependencies>
                    <dependency>
                        <groupId>net.trajano.wagon</groupId>
                        <artifactId>wagon-git</artifactId>
                        <version>2.0.4</version>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.maven.doxia</groupId>
                        <artifactId>doxia-module-markdown</artifactId>
                        <version>1.12.0</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.0.1</version>
                <configuration>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <tagNameFormat>@{project.version}</tagNameFormat>
                    <scmCommentPrefix xml:space="preserve">[RELEASE] </scmCommentPrefix>
                    <goals>install deploy site-deploy
                    </goals> <!-- install is here to fix javadoc generation in multi-module projects -->
                    <releaseProfiles>release</releaseProfiles>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
            </plugin>
        </plugins>
    </reporting>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>${velocity.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Shipped by the proxy itself, so it must not be shaded in. -->
        <dependency>
            <groupId>org.spongepowered</groupId>
            <artifactId>configurate-yaml</artifactId>
            <version>${configurate.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Not shipped by the proxy: shaded and relocated into the plugin jar. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
            <exclusions>
                <!-- Provided by the proxy. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>
        <dependency>
            <groupId>com.discord4j</groupId>
            <artifactId>discord4j-core</artifactId>
            <version>${discord4j.version}</version>
            <exclusions>
                <!-- Provided by the proxy. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.code.gson</groupId>
                    <artifactId>gson</artifactId>
                </exclusion>
                <!-- Source-retention annotation processor, unused at runtime. -->
                <exclusion>
                    <groupId>com.austinv11.servicer</groupId>
                    <artifactId>Servicer</artifactId>
                </exclusion>
                <!-- Netty looks its native libraries up by package name, so they cannot
                     load once Netty is relocated. Reactor Netty falls back to NIO. -->
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-epoll</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-resolver-dns-native-macos</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-native-quic</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Makes the plugin's own log output visible while tests run. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
