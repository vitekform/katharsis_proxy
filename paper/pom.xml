<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.ganamaga</groupId>
    <artifactId>katharsis_paper</artifactId>
    <version>0.1</version>
    <packaging>jar</packaging>

    <name>katharsis_paper</name>
    <description>Backend companion for the Katharsis Velocity proxy plugin.</description>

    <properties>
        <!--
          Built against the OLDEST supported Paper API, and targeting the JDK
          that API requires. A plugin compiled against an old API runs on newer
          servers; the reverse does not hold. That one decision is what makes a
          single jar cover 1.21.1 through 26.2.

          Do not "upgrade" these to the newest Paper: compiling against 26.2
          would produce Java 25 bytecode that no 1.21.x server can even load.
          compat-check.sh proves the API surface used here exists across the
          whole range.
        -->
        <java.release>21</java.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.version>1.21.1-R0.1-SNAPSHOT</paper.version>
        <!-- Declared in plugin.yml as the MINIMUM server this plugin supports,
             not the newest. PluginDescriptorTest checks it stays consistent
             with paper.version. -->
        <paper.api.version>1.21</paper.api.version>
        <!-- Oldest and newest servers this jar is meant to run on. Documented
             in docs/companion-plugin.md and checked by compat-check.sh. -->
        <paper.supported.min>1.21.1</paper.supported.min>
        <paper.supported.max>26.2</paper.supported.max>
        <junit.version>5.14.4</junit.version>
        <surefire.version>3.6.0</surefire.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>require-jdk-for-paper-api</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Literal, not ${java.release}: Maven also exposes the
                                     running JVM's own java.* system properties, and a pom
                                     property that collides with one is a coin flip. -->
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>This module is built against the Paper 1.21.1 API, which needs JDK 21 or newer.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- So PluginDescriptorTest can check that the version
                         properties stay consistent with each other. -->
                    <systemPropertyVariables>
                        <katharsis.paper.version>${paper.version}</katharsis.paper.version>
                        <katharsis.paper.api.version>${paper.api.version}</katharsis.paper.api.version>
                        <katharsis.paper.supported.min>${paper.supported.min}</katharsis.paper.supported.min>
                        <katharsis.paper.supported.max>${paper.supported.max}</katharsis.paper.supported.max>
                        <katharsis.java.release>${java.release}</katharsis.java.release>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
